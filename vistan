  code { background: #221f18; }
  pre { background: #191712; }
  footer .warn { color: #d09a6a; }
  .answer button { background: var(--ink); color: #13120e; }
}
</style>
</head>
<body>
<main>
<h1>$title</h1>
<p class="src">$src_html</p>
HTML

    awk -v canon="$canon" -v template="$template" -v done="$done_label" '
BEGIN {
  if (canon != "") n = split(canon, need, ";")
  sel = (template == "seleccion" || template == "selection")
}

function esc(s) {
  gsub(/&/, "\\&amp;", s); gsub(/</, "\\&lt;", s); gsub(/>/, "\\&gt;", s)
  gsub(/"/, "\\&quot;", s)
  return s
}

function inline(s,   k, p, out, j) {
  s = esc(s)
  if (index(s, "`") == 0) return s
  k = split(s, p, "`"); out = p[1]
  for (j = 2; j <= k; j++) out = out (j % 2 == 0 ? "<code>" : "</code>") p[j]
  if (k % 2 == 0) out = out "</code>"
  return out
}

function html_body(from,   i, open, line, indent, lvl, fence) {
  open = 0; fence = 0
  for (i = from; i <= body_n; i++) {
    line = body[i]
    if (line ~ /^[ \t]*```/) {
      if (fence) { print "</code></pre>"; fence = 0 }
      else {
        if (open) { print "</ul>"; open = 0 }
        print "<pre><code>"; fence = 1
      }
      continue
    }
    if (fence) { print esc(line); continue }
    if (line ~ /^[ \t]*[-*][ \t]/) {
      if (!open) { print "<ul>"; open = 1 }
      match(line, /^[ \t]*/)
      lvl = int(RLENGTH / 2)
      sub(/^[ \t]*[-*][ \t]+/, "", line)
      printf "<li style=\"--l:%d\">%s</li>\n", lvl, inline(line)
    } else if (line ~ /^[ \t]*$/) {
      if (open) { print "</ul>"; open = 0 }
    } else {
      if (open) { print "</ul>"; open = 0 }
      printf "<p>%s</p>\n", inline(line)
    }
  }
  if (fence) print "</code></pre>"
  if (open) print "</ul>"
}

function option(   i, f, key, val) {
  if (!opened) {
    print "<fieldset class=\"opts\">"
    print "<legend class=\"sr-only\">Pick one</legend>"
    opened = 1
  }
  f = 1; while (f <= body_n && body[f] ~ /^[ \t]*$/) f++
  while (body_n >= f && body[body_n] ~ /^[ \t]*$/) body_n--
  opt_n++
  key = (opt_n <= 26) ? sprintf("%c", 64 + opt_n) : sprintf("%d", opt_n)
  val = cur; gsub(/[`*]/, "", val)
  val = key ": " val
  printf "<section class=\"opt\">\n<label class=\"pick\"><input type=\"radio\" name=\"opt\" value=\"%s\"><span class=\"key\">%s</span><span class=\"ttl\">%s</span></label>\n<div class=\"desc\">\n", esc(val), key, inline(cur)
  if (f <= body_n) { html_body(f) } else { print "<p class=\"empty\">no description</p>" }
  print "</div>\n</section>"
  body_n = 0; cur = ""
}

function render(   i, f, items) {
  f = 1; while (f <= body_n && body[f] ~ /^[ \t]*$/) f++
  while (body_n >= f && body[body_n] ~ /^[ \t]*$/) body_n--

  if (sel && cur != "") { option(); return }

  if (cur == "") {
    if (f <= body_n) html_body(f)
  } else {
    items = 0
    for (i = f; i <= body_n; i++) if (body[i] ~ /^[ \t]*[-*][ \t]/) items++
    if (f <= body_n) filled[cur] = 1
    printf "<section>\n<h2>%s <span>%d</span></h2>\n", inline(cur), items
    if (f <= body_n) html_body(f)
    else print "<p class=\"empty\">no content</p>"
    print "</section>"
  }
  body_n = 0; cur = ""
}

/^[ \t]*```/ { infence = !infence; body[++body_n] = $0; next }
infence { body[++body_n] = $0; next }

/^#[ \t]/ { next }

/^## / {
  render()
  cur = substr($0, 4); gsub(/^[ \t]+|[ \t]+$/, "", cur)
  next
}

{ body[++body_n] = $0 }

END {
  render()
  if (sel) {
    if (opened) {
      print "<section class=\"opt\">"
      print "<label class=\"pick\"><input type=\"radio\" name=\"opt\" value=\"None: ask for another option\"><span class=\"key\">-</span><span class=\"ttl\">None of these</span></label>"
      print "</section>"
      print "</fieldset>"
    }
    exit
  }
  if (canon != "") {
    for (i = 1; i <= n; i++) if (!filled[need[i]]) miss = miss " " need[i]
    if (miss != "") printf "<footer><span class=\"warn\">Missing or empty:%s</span></footer>\n", miss
    else printf "<footer>%s</footer>\n", done
  }
}
' "$src"

    if [ "$template" = "selection" ]; then
      cat <<'HTML'
