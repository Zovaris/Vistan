#!/usr/bin/env bash
# vistan: turn a Markdown document into something a human can read, in the terminal
# or in a browser served from a local process.
#
#   vistan <file.md>              print it in the terminal
#   vistan serve <file.md>        build the page, start the server and open it
#   vistan stop                   stop the server
#   vistan new <template>         print a template to stdout
#   vistan templates              list the templates
#
# Templates: plan, summary, selection, map, diagram.
# Declare one inside the document with  <!-- vistan: map -->  or pass --template.
#
# Terminal exit codes: 0 complete, 1 missing or empty section, 2 cannot read.
# Env: VISTAN_PORT (default 8765), VISTAN_NO_OPEN=1 to skip the browser,
#      VISTAN_CACHE to move the generated pages and the server pid file.
set -euo pipefail

VROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
TEMPLATES=$VROOT/templates
CACHE="${VISTAN_CACHE:-${TMPDIR:-/tmp}/vistan}"

usage() {
  printf 'usage: %s <file.md> | serve <file.md> | stop | new <template> | templates\n\n' "${0##*/}" >&2
  printf '  serve        build the page, start a local server and open it\n' >&2
  printf '  new          print a template to stdout\n' >&2
  printf '  --template   override the template declared in the document\n' >&2
}

sections_for() {
  case "$1" in
    plan) printf '%s' 'Decisions;Rejected;Verification;Your move' ;;
    summary) printf '%s' 'What changed;Verification;Pending' ;;
    map) printf '%s' 'Entry points;Modules;Data flow;Gotchas' ;;
    selection|diagram) printf '' ;;
  esac
}

label_for() {
  case "$1" in
    plan) printf 'Plan complete' ;;
    summary) printf 'Summary complete' ;;
    selection) printf 'Decision complete' ;;
    map) printf 'Map complete' ;;
    diagram) printf 'Diagram complete' ;;
  esac
}

port_free() {
  python3 -c 'import socket, sys
s = socket.socket()
s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
try:
    s.bind(("127.0.0.1", int(sys.argv[1])))
except OSError:
    sys.exit(1)
sys.exit(0)' "$1" 2>/dev/null
}

stop_server() {
  pidfile="$CACHE/server"
  if [ ! -f "$pidfile" ]; then
    printf 'no server running\n'
    return 0
  fi
  pid=$(cut -d' ' -f1 "$pidfile")
  kill "$pid" 2>/dev/null || true
  rm -f "$pidfile"
  printf 'server stopped\n'
}

start_server() {
  pidfile="$CACHE/server"
  if [ -f "$pidfile" ]; then
    pid=$(cut -d' ' -f1 "$pidfile")
    known=$(cut -d' ' -f2 "$pidfile")
    if kill -0 "$pid" 2>/dev/null; then
      port=$known
      return 0
    fi
    rm -f "$pidfile"
  fi
  port=${VISTAN_PORT:-8765}
  if ! port_free "$port"; then
    printf 'port %s is busy; run with VISTAN_PORT=<other>\n' "$port" >&2
    exit 2
  fi
  pid=$(python3 - "$CACHE" "$port" <<'PY'
import subprocess, sys
server = subprocess.Popen(
    [sys.executable, "-m", "http.server", sys.argv[2], "--bind", "127.0.0.1"],
    cwd=sys.argv[1],
    stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    start_new_session=True,
)
print(server.pid)
PY
)
  printf '%s %s\n' "$pid" "$port" > "$pidfile"
}

main() {
  cmd=show
  case "${1:-}" in
    serve|stop|new|templates) cmd=$1; shift ;;
    -h|--help|'') usage; exit 2 ;;
  esac

  if [ "$cmd" = "stop" ]; then stop_server; exit 0; fi
  if [ "$cmd" = "templates" ]; then
    ls -1 "$TEMPLATES" 2>/dev/null | sed 's/\.md$//'
    exit 0
  fi
  if [ "$cmd" = "new" ]; then
    [ $# -ge 1 ] || { usage; exit 2; }
    tpl=$TEMPLATES/$1.md
    [ -f "$tpl" ] || { printf 'unknown template: %s\n' "$1" >&2; exit 2; }
    cat "$tpl"
    exit 0
  fi

  template=
  src=
  while [ $# -gt 0 ]; do
    case "$1" in
      --template)
        [ $# -ge 2 ] || { usage; exit 2; }
        template=$2; shift 2 ;;
      -) src=-; shift ;;
      -*) printf 'unknown option: %s\n' "$1" >&2; exit 2 ;;
      *) src=$1; shift ;;
    esac
  done
  [ -n "$src" ] || { usage; exit 2; }

  shown=$src
  cleanup=
  if [ "$src" = "-" ]; then
    tmp=$(mktemp "${TMPDIR:-/tmp}/vistan.XXXXXX")
    cleanup=$tmp
    cat > "$tmp"
    src=$tmp
    shown="(stdin)"
    name=document
  elif [ -f "$src" ]; then
    name=$(basename "$src")
    name=${name%.md}
  else
    printf 'not found: %s\n' "$src" >&2
    exit 2
  fi
  [ -n "$cleanup" ] && trap 'rm -f "$cleanup"' EXIT

  if [ -z "$template" ]; then
    template=$(sed -n '/vistan:/{s/.*vistan:[[:space:]]*\([a-z][a-z-]*\).*/\1/p;q;}' "$src")
  fi
  [ -n "$template" ] || template=plan

  case "$template" in
    plan|summary|selection|map|diagram) ;;
    *) printf 'unknown template: %s\n' "$template" >&2; exit 2 ;;
  esac

  canon=$(sections_for "$template")
  done_label=$(label_for "$template")

  if [ "$cmd" = "show" ]; then
    render_terminal
  else
    render_page
  fi
}

render_terminal() {
  color=1
  if [ -n "${NO_COLOR:-}" ] || [ ! -t 1 ]; then color=0; fi

  awk -v color="$color" -v src="$shown" -v canon="$canon" -v done="$done_label" \
      -v template="$template" '
BEGIN {
  if (color) {
    B = "\033[1m"; CY = "\033[1;36m"; MA = "\033[1;35m"; GR = "\033[1;32m"
    YE = "\033[1;33m"; WH = "\033[1;37m"; DIM = "\033[2m"
    OK = "\033[32m"; WARN = "\033[33m"; R = "\033[0m"
  } else {
    B = CY = MA = GR = YE = WH = DIM = OK = WARN = R = ""
  }
  col["Decisions"] = CY; col["Rejected"] = MA
  col["Verification"] = GR; col["Your move"] = YE
  col["What changed"] = CY; col["Pending"] = YE
  col["Entry points"] = CY; col["Modules"] = GR
  col["Data flow"] = MA; col["Gotchas"] = YE
  if (canon != "") n = split(canon, need, ";")
  sel = (template == "selection")
  IND = "  "
}

function render(   i, f, items, h, k) {
  f = 1; while (f <= body_n && body[f] ~ /^[ \t]*$/) f++
  while (body_n >= f && body[body_n] ~ /^[ \t]*$/) body_n--

  if (cur == "") {
    if (f <= body_n) {
      print ""
      for (i = f; i <= body_n; i++) if (body[i] !~ /^[ \t]*```/) print IND body[i]
    }
  } else {
    items = 0
    for (i = f; i <= body_n; i++) if (body[i] ~ /^[ \t]*[-*][ \t]/) items++
    h = (cur in col) ? col[cur] : WH
    k = sel ? sprintf("%c) ", 64 + ++opt_n) : ""
    printf "\n%s%s▌%s %s%s%s%s", IND, h, R, h, k, cur, R
    if (f <= body_n) { filled[cur] = 1; printf " %s· %d%s\n", DIM, items, R }
    else { printf " %s· empty%s\n", DIM, R }
    for (i = f; i <= body_n; i++) if (body[i] !~ /^[ \t]*```/) print IND body[i]
  }
  body_n = 0; cur = ""
}

/^[ \t]*```/ { infence = !infence; body[++body_n] = $0; next }
infence { body[++body_n] = $0; next }

/^#[ \t]/ {
  t = substr($0, 3); gsub(/^[ \t]+|[ \t]+$/, "", t)
  printf "\n%s%s%s%s\n", IND, B, t, R
  printf "%s%s%s%s\n", IND, DIM, src, R
  next
}

/^## / {
  render()
  cur = substr($0, 4); gsub(/^[ \t]+|[ \t]+$/, "", cur)
  next
}

{ body[++body_n] = $0 }

END {
  render()
  for (i = 1; i <= n; i++) if (!filled[need[i]]) miss = miss " " need[i]
  if (miss != "") {
    printf "\n%s%s! missing or empty:%s%s%s\n", IND, WARN, R, miss, R
    exit 1
  }
  printf "\n%s%s+ %s%s\n", IND, OK, tolower(done), R
}
' "$src"
}

render_page() {
  outdir="$CACHE"
  mkdir -p "$outdir"
  out="$outdir/$name.html"

  raw_title=$(sed -n '/^#[ \t]/{s/^#[ \t]*//;p;q;}' "$src")
  [ -n "$raw_title" ] || raw_title=$name
  title=$(printf '%s' "$raw_title" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g')
  src_html=$(printf '%s' "$shown" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g')

  {
    cat <<HTML
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>$title</title>
<style>
:root {
  color-scheme: light dark;
  --paper: #f6f3ea;
  --ink: #1b1a17;
  --muted: #625e55;
  --rule: #d2ccbf;
  --field: #fffdf6;
}
* { box-sizing: border-box; }
html { background: var(--paper); }
body { margin: 0; background: var(--paper); color: var(--ink);
  font-family: "Iowan Old Style", "Palatino Linotype", "URW Palladio L", P052, Palatino, Georgia, serif;
  font-size: 17px; line-height: 1.6; -webkit-font-smoothing: antialiased; }
main { width: min(38rem, calc(100vw - 2.5rem)); margin: 0 auto; padding: 80px 0 96px; }
h1 { margin: 0 0 8px; font-size: 2.05rem; line-height: 1.16; font-weight: 400;
  letter-spacing: -0.015em; text-wrap: balance; }
